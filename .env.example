# Master on/off switch for self-healing.
HEALER_ENABLED=true

# Which provider backs self-healing: openai | anthropic | gemini | ollama | ollama-local
HEALER_PROVIDER=openai

# Opt-in: if a healed locator resolves but the action on it still fails, retry
# with scroll / short wait / force before giving up. Off by default — force:true
# can act on an element in a way a real user couldn't. See README's "Action
# recovery" section.
# HEALER_ACTION_RECOVERY_ENABLED=true

# --- OpenAI ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Google Gemini ---
# GEMINI_MODEL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Ollama Cloud (https://ollama.com) ---
# HEALER_PROVIDER=ollama
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com

# --- Ollama, self-hosted (a separate provider from Ollama Cloud above) ---
# HEALER_PROVIDER=ollama-local
# OLLAMA_LOCAL_MODEL=gpt-oss:120b
# OLLAMA_LOCAL_BASE_URL=http://localhost:11434
# OLLAMA_LOCAL_API_KEY=
